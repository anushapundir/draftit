# Enables live runs in the app and npm run draft. Without it the app replays data/demo-run.json.
ANTHROPIC_API_KEY=
DRAFTIT_MODEL=claude-sonnet-5-5
# Only for an API key not scoped to a workspace (Console > Settings > Workspaces).
ANTHROPIC_WORKSPACE_ID=
# Required anywhere but `next dev` for live runs. Open the app with ?token=<value>.
DEMO_ACCESS_TOKEN=
# The shared demo login. Defaults: demo@draftit.dev / draftit
DEMO_EMAIL=
DEMO_PASSWORD=
